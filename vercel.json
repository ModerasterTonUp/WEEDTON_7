{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "tonconnect-manifest.json", "use": "@vercel/static" }
  ],
  "headers": [
    {
      "source": "/tonconnect-manifest.json",
      "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }]
    }
  ]
}
